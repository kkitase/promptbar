{
  "manifest_version": 3,
  "name": "Prompt Bar",
  "version": "1.0.0",
  "description": "Chromeサイドパネルでプロンプトを管理・コピーできる拡張機能",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "Prompt Bar を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}